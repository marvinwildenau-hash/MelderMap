    "shortDescription": "Melderprüfung nach Laufweg",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCMkYxNTk0RjJGMkMxMTYKUldRV3dmTHlsQlV2RzM0RFM2OXBZUzBxUytaNHkxUGJmNGtLSTVxUFhkY2pkaWVnelpidW9ORVcK",
      "endpoints": [
        "https://marvinwildenau-hash.github.io/MelderMap/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
