{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MelderMap",
  "version": "1.16.1",
  "identifier": "de.wildenau.meldermap",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MelderMap",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
