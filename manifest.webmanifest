{
 "name": "MelderMap",
 "short_name": "MelderMap",
 "description": "Melderprüfung nach Laufweg, offline",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#ffffff",
 "theme_color": "#ffffff",
 "lang": "de",
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "file",
     "accept": [
      "application/json",
      "application/octet-stream",
      ".json"
     ]
    }
   ]
  }
 },
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "maskable-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}